node_modules/
dist/
*.local
.DS_Store
Thumbs.db
.vscode/
*.log

# Screenshots dropped at the repo root, plus any stray capture. Art the app actually
# ships has to be exempt — it is imported by the source and a clone must build.
*.png
!src/icons/*.png
# The three README images are the one marketing-asset exception, agreed
# deliberately — see CLAUDE.md. Regenerated by tools/make-readme-shots.mjs.
!docs/readme/*.png

# Private/local-only store & marketing assets (mirrored to private Eren-Ozcan/pictures repo)
docs/store-assets-originals/

# Video, same rule as the images: the promo film and its raw capture stay out.
# The README's short GIF is the one exception, agreed the same way the three
# still images were — see CLAUDE.md. Written by tools/record-promo.mjs.
*.mp4
*.webm
*.gif
!docs/readme/*.gif

# Signed build outputs. A release bundle is 11 MB and is reproducible from a
# tag plus the keystore, so it never belongs in history.
*.aab
*.apk

# graphify knowledge-graph output
graphify-out/
