rules_version = '2';

// Arkadaş kodu doğrulaması + liderlik skoru için (bkz. src/services.ts FirebaseSocial).
// Tek koleksiyon: players/{code} — doküman ID'si oyuncunun REEF-XXXXX kodu.
//   { name: string, uid: string, updatedAt: Timestamp, score?: number }
//
// - get: herhangi bir signed-in (anonim) kullanıcı tek bir kodu doğrulayabilir.
// - list: kapalı — tüm kodların taranmasını/enumerate edilmesini engeller.
// - create/update: sadece kendi uid'ine ait dokümanı yazabilir.
// - delete: kapalı.
//
// score alanı istemci tarafından hesaplanıyor (stats.totalEarned) — Cloud Functions
// olmadan sunucu tarafında "gerçek" olduğu doğrulanamaz. Yine de tek istekte
// mantıksız bir sayı yazılmasını (bkz. güvenlik testi: score=999999999) engellemek
// için mutlak bir tavan ve update başına artış sınırı konur (en yüksek başarım
// hedefi 60.000.000 — bkz. quests.ts a-earn60m).
service cloud.firestore {
  match /databases/{database}/documents {
    match /players/{code} {
      allow get: if request.auth != null;
      allow list: if false;

      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 40
                    && (!('score' in request.resource.data)
                        || (request.resource.data.score is number
                            && request.resource.data.score >= 0
                            && request.resource.data.score <= 200000000));

      allow update: if request.auth != null
                    && resource.data.uid == request.auth.uid
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 40
                    && (!('score' in request.resource.data)
                        || (request.resource.data.score is number
                            && request.resource.data.score >= 0
                            && request.resource.data.score <= 200000000
                            && (!('score' in resource.data)
                                || request.resource.data.score <= resource.data.score + 10000000)));

      allow delete: if false;
    }

    // Bulut kaydı (bkz. src/cloud-save.ts). Doküman kimliği oyuncunun Firebase
    // UID'sidir — platforma özgü bir kimlik DEĞİL, böylece aynı hesap Android
    // ve iOS'ta aynı kayda ulaşır.
    //
    // `rev` monotonik bir sayaçtır ve geriye gitmesi kural düzeyinde
    // yasaklanır: uzun süre çevrimdışı kalmış (bayat) bir istemci, başka bir
    // cihazın yazdığı daha yeni kaydı EZEMEZ. Bu garanti istemci mantığına
    // bırakılmaz — istemci kodu her zaman eski/değiştirilmiş olabilir.
    match /saves/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;

      allow create: if request.auth != null
                    && request.auth.uid == uid
                    && request.resource.data.payload is string
                    && request.resource.data.payload.size() <= 400000
                    && request.resource.data.rev is int
                    && request.resource.data.rev > 0
                    && request.resource.data.schemaVersion is int;

      allow update: if request.auth != null
                    && request.auth.uid == uid
                    && request.resource.data.payload is string
                    && request.resource.data.payload.size() <= 400000
                    && request.resource.data.rev is int
                    && request.resource.data.schemaVersion is int
                    && request.resource.data.rev > resource.data.rev;

      // Silme kapalı: kazara/kötü niyetli bir istekle ilerleme yok edilemesin.
      allow delete: if false;
    }
  }
}
