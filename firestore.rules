rules_version = '2';

// Friend-code verification + leaderboard score (see src/services.ts FirebaseSocial).
// One collection: players/{code} — the document id is the player's REEF-XXXXX code.
//   { name: string, uid: string, updatedAt: Timestamp, score?: number }
//
// - get: any signed-in (anonymous) user can verify a single code.
// - list: closed — stops every code being scanned or enumerated.
// - create/update: only the document belonging to your own uid.
// - delete: only your own document (see the note at the rule).
//
// The score field is computed on the client (stats.totalEarned) — without Cloud
// Functions it cannot be verified server-side as "real". An absolute ceiling and
// a per-update increase limit are still applied, to stop an absurd number being
// written in one request (see the security test: score=999999999). The highest
// achievement target is 60,000,000 — see quests.ts a-earn60m.
service cloud.firestore {
  match /databases/{database}/documents {
    match /players/{code} {
      allow get: if request.auth != null;
      allow list: if false;

      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 40
                    && (!('score' in request.resource.data)
                        || (request.resource.data.score is number
                            && request.resource.data.score >= 0
                            && request.resource.data.score <= 200000000));

      allow update: if request.auth != null
                    && resource.data.uid == request.auth.uid
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 40
                    && (!('score' in request.resource.data)
                        || (request.resource.data.score is number
                            && request.resource.data.score >= 0
                            && request.resource.data.score <= 200000000
                            && (!('score' in resource.data)
                                || request.resource.data.score <= resource.data.score + 10000000)));

      // A player may delete their own document, so the account deletion Play
      // requires (see https://yilkgames.com/account-deletion/) can run from
      // inside the app. Only their OWN: without the resource.data.uid check,
      // anyone holding a friend code could delete that player's record.
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // The cloud save (see src/cloud-save.ts). The document id is the player's
    // Firebase UID — NOT a platform-specific identifier, so the same account
    // reaches the same save on Android and iOS.
    //
    // `rev` is a monotonic counter and going backwards is forbidden at the rule
    // level: a stale client that has been offline for a long time CANNOT
    // overwrite the newer save another device wrote. This guarantee is not left
    // to client logic — client code can always be old or modified.
    match /saves/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;

      allow create: if request.auth != null
                    && request.auth.uid == uid
                    && request.resource.data.payload is string
                    && request.resource.data.payload.size() <= 400000
                    && request.resource.data.rev is int
                    && request.resource.data.rev > 0
                    && request.resource.data.schemaVersion is int;

      allow update: if request.auth != null
                    && request.auth.uid == uid
                    && request.resource.data.payload is string
                    && request.resource.data.payload.size() <= 400000
                    && request.resource.data.rev is int
                    && request.resource.data.schemaVersion is int
                    && request.resource.data.rev > resource.data.rev;

      // Deletion is open to the document's owner only. It used to be closed
      // outright, on the reasoning that progress must not be destroyed by an
      // accidental or malicious request — but that protection was already
      // absent: anyone who can write as this uid can overwrite the payload
      // with garbage at rev+1. The only real effect of keeping it closed was
      // to force a player deleting their own data through a manual,
      // email-driven process.
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
  }
}
