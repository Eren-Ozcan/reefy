rules_version = '2';

// Arkadaş kodu doğrulaması için (bkz. src/services.ts FirebaseSocial).
// Tek koleksiyon: players/{code} — doküman ID'si oyuncunun REEF-XXXXX kodu.
//   { name: string, uid: string, updatedAt: Timestamp }
//
// - get: herhangi bir signed-in (anonim) kullanıcı tek bir kodu doğrulayabilir.
// - list: kapalı — tüm kodların taranmasını/enumerate edilmesini engeller.
// - create/update: sadece kendi uid'ine ait dokümanı yazabilir.
// - delete: kapalı.
service cloud.firestore {
  match /databases/{database}/documents {
    match /players/{code} {
      allow get: if request.auth != null;
      allow list: if false;

      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 40;

      allow update: if request.auth != null
                    && resource.data.uid == request.auth.uid
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 40;

      allow delete: if false;
    }
  }
}
