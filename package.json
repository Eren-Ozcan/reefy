{
  "name": "reefy",
  "private": false,
  "version": "1.1.0",
  "description": "A cozy aquarium game for Android and iOS — collect fish, decorate tanks, and care for your reef.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Eren-Ozcan/reefy.git"
  },
  "bugs": {
    "url": "https://github.com/Eren-Ozcan/reefy/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "icons": "node tools/generate-icons.mjs",
    "smoke": "node test-reefy.mjs",
    "store:screens": "node tools/capture-store-screenshots.mjs",
    "store:feature": "node tools/make-feature-graphic.mjs",
    "event:dump": "node tools/dump-event-points.mjs"
  },
  "dependencies": {
    "@capacitor-community/admob": "^8.0.0",
    "@capacitor-community/safe-area": "^8.0.1",
    "@capacitor-firebase/authentication": "^8.3.0",
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.0",
    "@revenuecat/purchases-capacitor": "^13.4.0",
    "capacitor-game-connect-8": "^8.0.0",
    "firebase": "^12.16.0",
    "pixi.js": "^8.6.6"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "firebase-admin": "^14.3.0",
    "firebase-tools": "^15.24.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.61.1",
    "sharp": "^0.35.3",
    "typescript": "~5.6.3",
    "vite": "^6.0.7",
    "vitest": "^4.1.10"
  }
}
